# FluOS userland ports — pinned versions and SHA-256 checksums.
# Sourced by build.sh and smoke-test.sh. Keep in sync with ports/Dockerfile ARGs.
#
# Every source is fetched over HTTPS from its upstream and verified against the
# checksum below before it ever enters the Docker build context.

# --- source tarballs (built static from source) ---
ZSH_VERSION=5.9
ZSH_SHA256=9b8d1ecedd5b5e81fbf1918e876752a7dd948e05c1a0dba10ab863842d45acd5
ZSH_URL="https://sourceforge.net/projects/zsh/files/zsh/5.9/zsh-5.9.tar.xz/download"
ZSH_FILE=zsh-5.9.tar.xz

NCURSES_VERSION=6.5
NCURSES_SHA256=136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6
NCURSES_URL="https://ftp.gnu.org/gnu/ncurses/ncurses-6.5.tar.gz"
NCURSES_FILE=ncurses-6.5.tar.gz

CURL_VERSION=8.11.1
CURL_SHA256=c7ca7db48b0909743eaef34250da02c19bc61d4f1dcedd6603f109409536ab56
CURL_URL="https://curl.se/download/curl-8.11.1.tar.xz"
CURL_FILE=curl-8.11.1.tar.xz

# TLS for curl/git comes from Alpine's PREBUILT static OpenSSL
# (openssl-libs-static in alpine:3.20 → OpenSSL 3.3.x). We deliberately do NOT
# compile a TLS library from source: mbedTLS's bignum/crypto code reliably
# segfaulted the x86_64 GCC running under QEMU emulation on this arm64 host.

GIT_VERSION=2.47.1
GIT_SHA256=f3d8f9bb23ae392374e91cd9d395970dabc5b9c5ee72f39884613cd84a6ed310
GIT_URL="https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.47.1.tar.xz"
GIT_FILE=git-2.47.1.tar.xz

COREUTILS_VERSION=0.12.0
COREUTILS_SHA256=4fb327655cb4ffcbf2f16550cf9234079ffe839692f7aa1a6eda104af684e122
COREUTILS_URL="https://github.com/uutils/coreutils/archive/refs/tags/0.12.0.tar.gz"
COREUTILS_FILE=coreutils-0.12.0.tar.gz

# --- prebuilt static release binary (Go, statically linked by upstream) ---
FZF_VERSION=0.56.3
FZF_SHA256=78e96a88cecfbdb3ff65df89cc47c02573407aee0edd08c87e18a8033d498fef
FZF_URL="https://github.com/junegunn/fzf/releases/download/v0.56.3/fzf-0.56.3-linux_amd64.tar.gz"
FZF_FILE=fzf-0.56.3-linux_amd64.tar.gz

# --- built from crates.io via `cargo install` (version is the pin) ---
STARSHIP_VERSION=1.27.0
